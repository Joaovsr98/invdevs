---
// Seção "Presença no Google e nas IAs" (14/11/2026, versão 3: chat animado).
// Uma janela de chat de IA responde sozinha a pergunta de um cliente. Na aba "Hoje" o negócio do
// visitante não aparece; na aba "Com a VN Bueno" ele aparece na lista (sem prometer posição). O visitante não sai do site.
// É uma simulação: nomes fictícios e aviso visível. Promessa: trabalho e medição mensal, nunca "garantimos aparecer".
// Sem atributo style no HTML (a CSP bloqueia). Dados vão num atributo data-* e o script é externo.
import { linkWhatsApp } from '../data/site';

const cenarios = [
  {
    id: 'oficina',
    rotulo: 'Oficina',
    pergunta: 'Qual é uma boa oficina mecânica em Taboão da Serra?',
    voce: 'A sua oficina',
    pronto: 'preparada',
    concorrentes: ['Auto Center Avenida', 'Mecânica Bom Pneu', 'Oficina Dois Irmãos'],
  },
  {
    id: 'corretor',
    rotulo: 'Corretor',
    pergunta: 'Me indica um corretor de imóveis de confiança na zona sul de São Paulo?',
    voce: 'Você, corretor',
    pronto: 'preparado',
    concorrentes: ['Imobiliária Central', 'Lar Novo Imóveis', 'Casa Certa Corretora'],
  },
  {
    id: 'estetica',
    rotulo: 'Estética',
    pergunta: 'Onde fazer harmonização facial com segurança em São Paulo?',
    voce: 'A sua clínica',
    pronto: 'preparada',
    concorrentes: ['Clínica Bella Pele', 'Studio Face', 'Espaço Renova'],
  },
  {
    id: 'restaurante',
    rotulo: 'Restaurante',
    pergunta: 'Qual restaurante bom para almoçar perto da Avenida Paulista?',
    voce: 'O seu restaurante',
    pronto: 'preparado',
    concorrentes: ['Cantina da Praça', 'Sabor de Casa', 'Bistrô da Esquina'],
  },
];

const inicial = cenarios[0];

const camadas = [
  { titulo: 'Base técnica', texto: 'Site rápido, dados estruturados e o arquivo llms.txt, que explicam para o Google e para as IAs quem você é, o que faz e onde atende.' },
  { titulo: 'Perfil no Google', texto: 'Perfil da Empresa com categoria, endereço, horários e fotos certos, para o seu negócio entrar no mapa e nas buscas da região.' },
  { titulo: 'Conteúdo que responde', texto: 'Páginas e perguntas frequentes escritas do jeito que o seu cliente pergunta, que é como as IAs procuram respostas.' },
  { titulo: 'Medição todo mês', texto: 'As mesmas perguntas feitas nas principais IAs todo mês, com um relatório simples mostrando onde você apareceu e a evolução.' },
];
---

<section id="presenca" class="relative overflow-hidden border-t border-line/60 bg-ink-950 py-20 sm:py-28">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(40%_55%_at_80%_35%,rgb(124_58_237/0.22),transparent_70%),radial-gradient(35%_45%_at_10%_90%,rgb(34_211_238/0.12),transparent_70%)]" aria-hidden="true"></div>
  <div class="grid-bg pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>

  <div class="container-site relative">
    <div class="grid items-center gap-12 lg:grid-cols-[0.95fr_1.05fr]">
      <div>
        <p class="eyebrow">Presença no Google e nas IAs</p>
        <h2 class="mt-4 text-3xl font-bold leading-[1.1] sm:text-5xl">
          O seu cliente pergunta para a IA. <span class="text-gradient">Ela responde com o seu nome?</span>
        </h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-300">
          Antes de ligar, muita gente pergunta ao ChatGPT ou ao Google qual é a melhor opção da região. As IAs costumam apresentar algumas empresas relevantes para cada pesquisa. Estar preparado para essas buscas aumenta as chances de o seu negócio ser descoberto.
        </p>
        <p class="mt-4 max-w-xl text-slate-400">
          Veja ao lado a diferença entre um negócio que ninguém preparou para isso e um negócio que a gente preparou.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a id="chat-whats" href={linkWhatsApp('Olá! Vi a parte de presença nas IAs no site da VN Bueno Digital e quero melhorar a visibilidade do meu negócio.')} target="_blank" rel="noopener" class="btn-primary">Quero melhorar minha visibilidade</a>
          <a href="#orcamento" class="text-sm font-semibold text-slate-300 underline-offset-4 hover:text-white hover:underline">Ou peça um orçamento</a>
        </div>
      </div>

      <!-- Chat simulado -->
      <div id="chat-ia" data-cenarios={JSON.stringify(cenarios)} class="relative">
        <div class="mb-4 flex flex-wrap gap-2" role="group" aria-label="Escolha o tipo de negócio">
          {cenarios.map((c, i) => (
            <button type="button" data-cenario={c.id} aria-pressed={i === 0 ? 'true' : 'false'} class="rounded-full border border-white/15 bg-white/[0.04] px-3.5 py-1.5 text-sm text-slate-200 transition hover:border-violet-400/60 aria-pressed:border-transparent aria-pressed:bg-gradient-to-r aria-pressed:from-blue-500 aria-pressed:to-violet-500 aria-pressed:text-white">
              {c.rotulo}
            </button>
          ))}
        </div>

        <div class="overflow-hidden rounded-3xl border border-white/10 bg-ink-900/95 shadow-[0_40px_100px_-40px_rgb(124_58_237/0.8)]">
          <!-- barra da janela + abas -->
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 px-5 py-3.5">
            <div class="flex items-center gap-2">
              <span class="h-2.5 w-2.5 rounded-full bg-rose-400/70"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-amber-300/70"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-emerald-400/70"></span>
              <span class="ml-2 text-xs font-medium text-slate-400">Assistente de IA</span>
            </div>
            <div class="flex rounded-full border border-white/10 bg-ink-950 p-1 text-xs font-semibold" role="group" aria-label="Comparar resultado">
              <button type="button" data-modo="hoje" aria-pressed="true" class="rounded-full px-3 py-1.5 text-slate-400 transition aria-pressed:bg-white/10 aria-pressed:text-white">Hoje</button>
              <button type="button" data-modo="com" aria-pressed="false" class="rounded-full px-3 py-1.5 text-slate-400 transition aria-pressed:bg-gradient-to-r aria-pressed:from-blue-500 aria-pressed:to-violet-500 aria-pressed:text-white">Com a VN Bueno</button>
            </div>
          </div>

          <div class="min-h-[23rem] p-5 sm:p-6">
            <div class="flex justify-end">
              <p id="chat-pergunta" class="max-w-[88%] rounded-2xl rounded-tr-sm bg-gradient-to-br from-blue-600 to-violet-600 px-4 py-3 text-[0.95rem] leading-snug text-white shadow-lg shadow-violet-900/40">{inicial.pergunta}</p>
            </div>

            <div class="mt-5 flex gap-3">
              <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full bg-gradient-to-br from-cyan-400 to-violet-500 text-xs font-bold text-ink-950" aria-hidden="true">IA</span>
              <div class="min-w-0 flex-1" aria-live="polite">
                <div id="chat-digitando" class="hidden items-center gap-1.5 py-2" aria-hidden="true">
                  <span class="h-2 w-2 animate-pulse rounded-full bg-slate-400"></span>
                  <span class="h-2 w-2 animate-pulse rounded-full bg-slate-400 [animation-delay:200ms]"></span>
                  <span class="h-2 w-2 animate-pulse rounded-full bg-slate-400 [animation-delay:400ms]"></span>
                </div>
                <div id="chat-resposta">
                  <p class="text-[0.95rem] text-slate-200">Encontrei algumas opções bem avaliadas na região:</p>
                  <ol class="mt-3 space-y-2">
                    {inicial.concorrentes.map((n, i) => (
                      <li class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/[0.03] px-3.5 py-2.5 text-sm text-slate-200"><span class="text-slate-500">{i + 1}.</span>{n}</li>
                    ))}
                  </ol>
                  <p class="mt-4 text-sm font-semibold text-rose-300">{inicial.voce} não aparece na resposta.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <p class="mt-4 rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-xs leading-relaxed text-slate-300">Demonstração ilustrativa, com nomes fictícios. As recomendações variam conforme a plataforma e a pesquisa. Não há garantia de posicionamento.</p>
      </div>
    </div>

    <!-- Como trabalhamos a presença -->
    <div class="mt-20">
      <h3 class="max-w-2xl text-2xl font-bold sm:text-3xl">Como colocamos o seu negócio <span class="text-gradient">nessa resposta</span></h3>
      <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {camadas.map((c, i) => (
          <li class="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition hover:border-violet-400/50 hover:bg-white/[0.05]">
            <span class="font-display text-5xl font-bold text-white/10 transition group-hover:text-violet-400/30">{i + 1}</span>
            <h4 class="mt-2 text-lg font-semibold text-white">{c.titulo}</h4>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{c.texto}</p>
          </li>
        ))}
      </ol>
      <p class="mt-6 max-w-3xl text-xs leading-relaxed text-slate-500">
        Nenhuma empresa consegue garantir que uma IA vai citar o seu negócio. O que entregamos é o trabalho feito e a medição todo mês, com as mesmas perguntas, para você acompanhar a evolução.
      </p>
    </div>
  </div>
</section>

<script>
  // Chat simulado: monta a resposta item por item. Começa sozinho quando aparece na tela
  // ("Hoje" e depois "Com a VN Bueno"); qualquer clique do visitante assume o controle.
  type Cenario = { id: string; rotulo: string; pergunta: string; voce: string; pronto: string; concorrentes: string[] };

  const raiz = document.getElementById('chat-ia');
  const perguntaEl = document.getElementById('chat-pergunta');
  const respostaEl = document.getElementById('chat-resposta');
  const digitandoEl = document.getElementById('chat-digitando');

  if (raiz && perguntaEl && respostaEl && digitandoEl) {
    const cenarios: Cenario[] = JSON.parse(raiz.dataset.cenarios || '[]');
    const semMovimento = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let atual = cenarios[0];
    let modo: 'hoje' | 'com' = 'hoje';
    let rodada = 0; // cancela animações antigas
    let automatico = true;

    const espera = (ms: number) => new Promise((r) => setTimeout(r, semMovimento ? 0 : ms));

    const el = (tag: string, classe: string, texto?: string) => {
      const e = document.createElement(tag);
      e.className = classe;
      if (texto !== undefined) e.textContent = texto;
      return e;
    };

    const ESCONDIDO = ['opacity-0', 'translate-y-2'];
    const item = (conteudo: HTMLElement) => {
      conteudo.classList.add('transition', 'duration-500', ...(semMovimento ? [] : ESCONDIDO));
      return conteudo;
    };

    const linha = (n: number, nome: string) => {
      const li = el('li', 'flex items-center gap-3 rounded-xl border border-white/10 bg-white/[0.03] px-3.5 py-2.5 text-sm text-slate-200');
      li.append(el('span', 'text-slate-500', `${n}.`), document.createTextNode(nome));
      return item(li);
    };

    // O negócio do visitante entra na lista entre os outros, sem prometer primeiro lugar.
    const voceNaLista = (n: number, nome: string) => {
      const li = el('li', 'flex items-center gap-3 rounded-xl border border-emerald-400/40 bg-emerald-500/[0.08] px-3.5 py-2.5 text-sm text-white');
      li.append(el('span', 'text-slate-500', `${n}.`), el('strong', 'font-semibold', nome), el('span', 'ml-auto rounded-full bg-emerald-400/15 px-2 py-0.5 text-[0.7rem] font-semibold text-emerald-300', 'Você'));
      return item(li);
    };

    const mostrar = async () => {
      const minha = ++rodada;
      perguntaEl.textContent = atual.pergunta;
      respostaEl.replaceChildren();
      digitandoEl.classList.replace('hidden', 'flex');
      await espera(900);
      if (minha !== rodada) return;
      digitandoEl.classList.replace('flex', 'hidden');

      const pecas: HTMLElement[] = [];
      const lista = el('ol', 'mt-3 space-y-2');
      if (modo === 'hoje') {
        pecas.push(item(el('p', 'text-[0.95rem] text-slate-200', 'Encontrei algumas opções bem avaliadas na região:')));
        atual.concorrentes.forEach((n, i) => pecas.push(linha(i + 1, n)));
        pecas.push(item(el('p', 'mt-4 text-sm font-semibold text-rose-300', `${atual.voce} não aparece na resposta.`)));
      } else {
        pecas.push(item(el('p', 'text-[0.95rem] text-slate-200', 'Encontrei algumas opções bem avaliadas na região:')));
        pecas.push(linha(1, atual.concorrentes[0]), linha(2, atual.concorrentes[1]), voceNaLista(3, atual.voce), linha(4, atual.concorrentes[2]));
        pecas.push(item(el('p', 'mt-4 text-sm font-semibold text-emerald-300', `${atual.voce} fica mais ${atual.pronto} para ser encontrad${atual.pronto.endsWith("a") ? "a" : "o"}.`)));
      }

      respostaEl.append(pecas[0], lista, pecas[pecas.length - 1]);
      for (const p of pecas) {
        if (p.tagName === 'LI') lista.append(p);
        void p.offsetWidth; // garante a transição
        p.classList.remove(...ESCONDIDO);
        await espera(380);
        if (minha !== rodada) return;
      }
      if (automatico && modo === 'hoje') {
        await espera(2200);
        if (minha === rodada && automatico) trocarModo('com');
      }
    };

    const marcar = (seletor: string, ativo: string, atributo: string) => {
      raiz.querySelectorAll<HTMLButtonElement>(seletor).forEach((b) => b.setAttribute('aria-pressed', String(b.dataset[atributo] === ativo)));
    };

    const trocarModo = (m: 'hoje' | 'com') => {
      modo = m;
      marcar('[data-modo]', m, 'modo');
      mostrar();
    };

    raiz.querySelectorAll<HTMLButtonElement>('[data-modo]').forEach((b) =>
      b.addEventListener('click', () => { automatico = false; trocarModo(b.dataset.modo as 'hoje' | 'com'); }),
    );
    raiz.querySelectorAll<HTMLButtonElement>('[data-cenario]').forEach((b) =>
      b.addEventListener('click', () => {
        const c = cenarios.find((x) => x.id === b.dataset.cenario);
        if (!c) return;
        atual = c;
        marcar('[data-cenario]', c.id, 'cenario');
        automatico = true;
        trocarModo('hoje');
      }),
    );

    // começa quando o chat aparece na tela
    new IntersectionObserver((entradas, obs) => {
      if (entradas.some((e) => e.isIntersecting)) { obs.disconnect(); mostrar(); }
    }, { threshold: 0.4 }).observe(raiz);
  }
</script>
